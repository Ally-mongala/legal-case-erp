<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="shell-root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="za.co.mongala.legal.ui.controller.ShellController">

    <!-- Header -->
    <top>
        <HBox styleClass="shell-header">
            <Label text="&#9878;" styleClass="logo-mark"/>
            <VBox spacing="0">
                <Label text="LegalCase ERP" styleClass="app-title"/>
                <Label text="AI Legal Practice Management" styleClass="app-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="alertLabel" styleClass="badge" visible="false" managed="false" />
            <Label fx:id="userNameLabel" styleClass="header-user"/>
            <Label fx:id="roleBadge" styleClass="badge"/>
            <Button fx:id="logoutButton" text="Log out" styleClass="btn-ghost-dark"/>
        </HBox>
    </top>

    <!-- Navigation rail (populated per role) -->
    <left>
        <VBox fx:id="navList" styleClass="nav-rail"/>
    </left>

    <!-- Content area (views are loaded here) -->
    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>

    <!-- Status bar -->
    <bottom>
        <Label fx:id="statusBarLabel" text="LegalCase ERP" styleClass="statusbar"/>
    </bottom>
</BorderPane>
