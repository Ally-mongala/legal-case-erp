<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" spacing="14"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="za.co.mongala.legal.ui.controller.CasesController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label text="Cases" styleClass="page-title"/>
            <Label text="All matters in the firm &#183; double-click a case to open it" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search reference, client, party..." prefWidth="240"/>
        <ComboBox fx:id="statusFilter" prefWidth="160"/>
        <Button fx:id="newCaseButton" text="+ New case" styleClass="btn-primary"/>
    </HBox>

    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <Label text="All matters" styleClass="section-title"/>
        <TableView fx:id="caseTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="refCol" text="Reference" prefWidth="105"/>
                <TableColumn fx:id="titleCol" text="Case title" prefWidth="260"/>
                <TableColumn fx:id="clientCol" text="Client" prefWidth="140"/>
                <TableColumn fx:id="opposingCol" text="Opposing party" prefWidth="190"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="125"/>
                <TableColumn fx:id="hearingCol" text="Hearing" prefWidth="105"/>
                <TableColumn fx:id="openedCol" text="Opened" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
