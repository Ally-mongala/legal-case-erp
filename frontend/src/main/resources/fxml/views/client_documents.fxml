<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.Region?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" spacing="14"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="za.co.mongala.legal.ui.controller.ClientDocumentsController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label text="Shared documents" styleClass="page-title"/>
            <Label text="Download your documents and share new ones with your lawyer"
                   styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="shareButton" text="+ Share a document with your lawyer" styleClass="btn-primary"/>
    </HBox>

    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Documents on your matter" styleClass="section-title"/>
        <TableView fx:id="docTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="nameCol" text="File name" prefWidth="330"/>
                <TableColumn fx:id="caseCol" text="Case" prefWidth="120"/>
                <TableColumn fx:id="sharedCol" text="Shared on" prefWidth="170"/>
                <TableColumn fx:id="sizeCol" text="Size" prefWidth="90"/>
                <TableColumn fx:id="actionCol" text="Action" prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
