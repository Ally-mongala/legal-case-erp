<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.Region?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" spacing="14"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="za.co.mongala.legal.ui.controller.ActivityController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label text="Activity &amp; audit trail" styleClass="page-title"/>
            <Label text="Every sensitive action is logged and can be exported"
                   styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="downloadButton" text="Download audit history (CSV)" styleClass="btn-primary"/>
    </HBox>

    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Audit log &#40;most recent first&#41;" styleClass="section-title"/>
        <TableView fx:id="activityTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="timeCol" text="Timestamp" prefWidth="165"/>
                <TableColumn fx:id="userCol" text="User" prefWidth="120"/>
                <TableColumn fx:id="actionCol" text="Action" prefWidth="175"/>
                <TableColumn fx:id="detailsCol" text="Details" prefWidth="520"/>
                <TableColumn fx:id="levelCol" text="Level" prefWidth="110"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
