<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" spacing="14"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="za.co.mongala.legal.ui.controller.LawyerRatingsController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label text="Client ratings" styleClass="page-title"/>
            <Label text="Ratings submitted by your clients" styleClass="page-subtitle"/>
        </VBox>
    </HBox>

    <HBox fx:id="summaryRow" spacing="14"/>

    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <Label text="All ratings" styleClass="section-title"/>
        <TableView fx:id="ratingTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="caseCol" text="Case" prefWidth="110"/>
                <TableColumn fx:id="scoreCol" text="Score" prefWidth="120"/>
                <TableColumn fx:id="commentCol" text="Comment" prefWidth="480"/>
                <TableColumn fx:id="dateCol" text="Date" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
