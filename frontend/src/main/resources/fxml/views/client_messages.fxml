<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" spacing="14"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="za.co.mongala.legal.ui.controller.ClientMessagesController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label text="Messages" styleClass="page-title"/>
            <Label text="Secure messages with your attorney" styleClass="page-subtitle"/>
        </VBox>
    </HBox>

    <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <VBox fx:id="threadBox" spacing="8" styleClass="page"/>
        </ScrollPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextArea fx:id="composeArea" promptText="Write a message to your attorney..."
                      HBox.hgrow="ALWAYS" prefRowCount="3" wrapText="true"/>
            <Button fx:id="sendButton" text="Send" styleClass="btn-gold" prefHeight="70" minWidth="90"/>
        </HBox>
    </VBox>
</VBox>
