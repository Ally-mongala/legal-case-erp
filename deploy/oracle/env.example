# Copy to .env (setup-app-vm.sh does this for you and fills the secrets).
# NEVER commit .env to GitHub.

# Public address: ":80" for plain HTTP by IP, or your domain for automatic HTTPS
SITE_ADDRESS=:80

# Secrets - generated automatically by setup-app-vm.sh
LCE_JWT_SECRET=
LCE_ENCRYPTION_KEY=

# Database on VM 2 (private network). Filled in by setup-app-vm.sh from your answers.
LCE_DB_URL=jdbc:postgresql://10.0.0.2:5432/legalcase
LCE_DB_USER=legalcase
LCE_DB_PASSWORD=

# Optional: real Google Calendar (see docs/GOOGLE_CALENDAR_SETUP.md)
LCE_GOOGLE_CAL_ID=
LCE_GOOGLE_CLIENT_ID=
LCE_GOOGLE_CLIENT_SECRET=
LCE_GOOGLE_REFRESH_TOKEN=
