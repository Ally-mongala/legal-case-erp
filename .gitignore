# ---- Build output ----
target/
build/
out/
dist/
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.class

# ---- Runtime data (encrypted documents, H2 database, uploads) ----
data/
*.db
*.mv.db
*.trace.db
uploads/

# ---- Secrets and environment ----
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
google-oauth.json

